# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# --- Jupyter ---
.ipynb_checkpoints/

# --- Data & models (never commit large/raw data or trained artifacts) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.parquet
*.pkl
*.joblib
*.onnx
*.pt
*.h5
models/*.bin
mlruns/
mlartifacts/

# --- Env / secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- MLOps tooling ---
.dvc/cache
.dvc/tmp
airflow.db
airflow-webserver.pid
logs/
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Docker ---
*.override.yml

# Markdown: ignore everything by default, only these are pushed
*.md
!README.md
!docs/PRD.md
!docs/architecture.md